NODE_ENV=development
PORT=3001

# PostgreSQL (Cloud SQL)
DATABASE_URL=postgresql://user:password@localhost:5432/moverix

# Firebase Admin (Auth)
FIREBASE_PROJECT_ID=moverix
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@moverix.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Cloud Storage
GCS_BUCKET_NAME=moverix-storage
GCS_PROJECT_ID=moverix

# App
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,https://admin.moverix.com
